<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template (LaunchDaemon, --system): scripts/install-service-macos.sh replaces the {{PLACEHOLDERS}}. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{LABEL}}</string>

  <!-- A daemon runs as root unless told otherwise; run as the installing user so ~/.claude and the project files work. -->
  <key>UserName</key>
  <string>{{USER_NAME}}</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{NODE_BIN}}</string>
    <string>{{PROJECT_DIR}}/node_modules/tsx/dist/cli.mjs</string>
    <string>src/main.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>{{PROJECT_DIR}}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{PATH}}</string>
    <key>HOME</key>
    <string>{{HOME_DIR}}</string>
    <key>USER</key>
    <string>{{USER_NAME}}</string>
{{CLAUDE_ENV}}
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <!-- Only keep the job alive while the project volume is mounted (an external disk may appear after boot). -->
  <key>KeepAlive</key>
  <dict>
    <key>PathState</key>
    <dict>
      <key>{{PROJECT_DIR}}/package.json</key>
      <true/>
    </dict>
  </dict>
  <!-- Wait at least 10 s between restarts so a crash loop does not hammer Discord's gateway. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <!-- Give a stopping bot time to finalize WAV files, restore its nickname and finish queued transcriptions (the bot bounds that wait at 150 s). -->
  <key>ExitTimeOut</key>
  <integer>180</integer>

  <key>StandardOutPath</key>
  <string>{{PROJECT_DIR}}/logs/discord-scribe.log</string>
  <key>StandardErrorPath</key>
  <string>{{PROJECT_DIR}}/logs/discord-scribe.err.log</string>
</dict>
</plist>
