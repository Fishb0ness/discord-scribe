# Discord application (see README for registration steps)
DISCORD_TOKEN=
DISCORD_APP_ID=
# Required: comma-separated server (guild) ids where the bot may work.
# Commands are registered only there; the bot leaves any other server it is added to.
ALLOWED_GUILD_IDS=

# whisper.cpp
WHISPER_BIN=whisper-cli
WHISPER_MODEL=models/ggml-large-v3.bin
WHISPER_VAD_MODEL=models/ggml-silero-v5.1.2.bin
WHISPER_LANGUAGE=es
# Beam size and best-of for decoding (higher is slower and a bit more accurate)
WHISPER_BEAM_SIZE=8
# Initial prompt (Castilian punctuation + vocabulary). Unset uses the built-in default; empty disables it.
# WHISPER_PROMPT=

# Summarizer (Claude Code CLI)
SUMMARY_ENABLED=true
CLAUDE_BIN=claude

# Output
RECORDINGS_DIR=recordings
